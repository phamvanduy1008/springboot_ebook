# Copy to .env in the repository root. Java properties syntax, no export/quotes.
# Credentials stay local; an empty password is deliberately not a real account.
SPRING_PROFILES_ACTIVE=local
DB_URL=jdbc:postgresql://127.0.0.1:5432/epub
DB_USERNAME=epub_dev
DB_PASSWORD=
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false
MAIL_FROM=noreply@example.test
STORAGE_ROOT=./var/storage
APP_PUBLIC_ORIGIN=http://localhost:5173
FRONTEND_HASH_ROUTING=true
GOOGLE_LOGIN_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/v1/login/oauth2/code/google
# Optional local-only browser administrator seed. Store the real password in ignored .env.
APP_LOCAL_ADMIN_SEED_ENABLED=false
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
